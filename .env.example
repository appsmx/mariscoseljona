# ============================================
# Mariscos El Jona — Variables de entorno
# ============================================
# Copia este archivo a .env y completa los valores.
# NUNCA subas .env a git (ya está en .gitignore).

# Base de datos (SQLite, ruta local)
DATABASE_URL="file:/home/z/my-project/db/custom.db"

# NextAuth.js (generar con: openssl rand -hex 32)
NEXTAUTH_SECRET="tu-secret-aqui-generado-con-openssl-rand-hex-32"

# (Opcional) URL del sitio en producción
# NEXTAUTH_URL="https://mariscoseljona.mx"
